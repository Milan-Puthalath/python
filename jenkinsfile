pipeline {
    agent any

    stages {

        stage('Check Python') {
            steps {
                bat 'py --version'
                bat 'py -m pip --version'
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'py -m pip install -r requirements.txt'
            }
        }

        stage('Test') {
            steps {
                bat 'py -m pytest'
            }
        }

        stage('Build') {
            steps {
                bat 'py -m compileall .'
            }
        }
    }
}
            steps {
                bat 'mkdir build'
                bat 'copy app.py build\\'
                bat 'copy requirements.txt build\\'
            }
        }
    }
}
